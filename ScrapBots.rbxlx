	</Item></Item><Item class="ServerScriptService" referent="RBX8"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- Loads and saves player data. Nothing else touches the DataStore.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local STORE_NAME = "PlayerData_v1"
local AUTOSAVE_SECONDS = 120
local LOAD_ATTEMPTS = 3

local Data = {}
local profiles = {} -- [player] = { data = table, canSave = boolean }

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore unavailable, progress will not save: " .. tostring(result))
	end
end

local function defaults()
	return {
		version = 1,
		coins = 0,
		scrap = 0, -- units in the backpack
		pending = 0, -- coin value of the backpack
		toolIndex = 1,
		backpackIndex = 1,
		zoneIndex = 1, -- highest zone unlocked
		totalScrap = 0,
		rebirths = 0,
		bots = {}, -- list of { id = string, polished = boolean, equipped = boolean }
		index = {}, -- [botId] = true for every bot ever found
	}
end

local function keyFor(player)
	return "player_" .. player.UserId
end

function Data.load(player)
	local data
	local loaded = false

	if store then
		for attempt = 1, LOAD_ATTEMPTS do
			local ok, result = pcall(function()
				return store:GetAsync(keyFor(player))
			end)
			if ok then
				data = result
				loaded = true
				break
			end
			warn(string.format("[Data] Load attempt %d failed for %s: %s", attempt, player.Name, tostring(result)))
			task.wait(2)
		end
	end

	if not loaded then
		if RunService:IsStudio() then
			warn("[Data] Using temporary data in Studio. Turn on API access in Game Settings to test saving.")
		else
			-- Never let a player play on blank data that could overwrite their real save.
			player:Kick("Your data could not be loaded. Please rejoin.")
			return nil
		end
	end

	if player.Parent ~= Players then
		return nil
	end

	if type(data) ~= "table" then
		data = defaults()
	else
		for key, value in pairs(defaults()) do
			if data[key] == nil then
				data[key] = value
			end
		end
	end

	profiles[player] = { data = data, canSave = loaded }
	return data
end

function Data.get(player)
	local profile = profiles[player]
	return profile and profile.data or nil
end

-- Wipes a player back to a new save. Developer testing only.
function Data.reset(player)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	profile.data = defaults()
	return profile.data
end

function Data.save(player)
	local profile = profiles[player]
	if not profile or not profile.canSave then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(keyFor(player), profile.data)
	end)
	if not ok then
		warn(string.format("[Data] Save failed for %s: %s", player.Name, tostring(err)))
	end
end

function Data.release(player)
	Data.save(player)
	profiles[player] = nil
end

task.spawn(function()
	while true do
		task.wait(AUTOSAVE_SECONDS)
		for player in pairs(profiles) do
			task.spawn(Data.save, player)
		end
	end
end)

game:BindToClose(function()
	local remaining = 0
	for player in pairs(profiles) do
		remaining = remaining + 1
		task.spawn(function()
			Data.save(player)
			remaining = remaining - 1
		end)
	end
	while remaining > 0 do
		task.wait()
	end
end)

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Builds the grey-box map from Config so no manual building is needed yet.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Props = require(ReplicatedStorage:WaitForChild("Props"))

local World = {}

local WHITE = Color3.fromRGB(255, 255, 255)

local function newPart(parent, name, size, cframe, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Parent = parent
	return part
end

local function addLabel(part, text, height)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromScale(16, 4) -- in studs, so the sign keeps its size in the world at any distance
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.MaxDistance = 150
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = WHITE
	label.TextStrokeTransparency = 0
	label.Text = text
	label.Parent = gui
	return label
end

local function addPrompt(part, actionText, objectText)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	return prompt
end

-- Swaps a grey box for its Toolbox model. The box stays as the invisible holder of the sign and
-- prompt. Does nothing if the model is missing.
local function dress(part, name, size, turn)
	local model = Props.make(name, true)
	if not model then
		return
	end
	local floor = part.Position.Y - part.Size.Y / 2
	Props.fit(model, size, Vector3.new(part.Position.X, floor + size.Y / 2, part.Position.Z), turn)
	Props.turn(model, Config.PropYaw[name] or 0)
	model.Name = "Visual"
	model.Parent = part
	part.Transparency = 1
	part.CanCollide = false
end

function World.build()
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = Workspace

	local size = Config.ZoneSize
	local half = size / 2
	local zones = {}

	for index, zone in ipairs(Config.Zones) do
		local folder = Instance.new("Folder")
		folder.Name = zone.id
		folder.Parent = map

		local centerX = (index - 1) * (size + Config.ZoneGap)
		local frontZ = -half + 15 -- row of stations along the front edge

		newPart(folder, "Floor", Vector3.new(size, 4, size), CFrame.new(centerX, -2, 0), zone.floor, Enum.Material.Ground)

		local arrivalPos = Vector3.new(centerX, 3, -half + 38)
		local arrival = CFrame.lookAt(arrivalPos, arrivalPos + Vector3.new(0, 0, 1))

		if index == 1 then
			local spawn = Instance.new("SpawnLocation")
			spawn.Anchored = true
			spawn.Size = Vector3.new(10, 1, 10)
			spawn.CFrame = CFrame.new(centerX, 0.5, -half + 38)
			spawn.Color = Color3.fromRGB(240, 240, 240)
			spawn.TopSurface = Enum.SurfaceType.Smooth
			spawn.Parent = folder
		end

		local crusher = newPart(folder, "Crusher", Vector3.new(14, 1, 14), CFrame.new(centerX, 0.5, frontZ + 7),
			Color3.fromRGB(242, 183, 5), Enum.Material.Neon)
		addLabel(crusher, "CRUSHER\nWalk here to sell", 13)

		-- The crusher machine stands behind the pad, so the pad stays easy to walk onto.
		local machine = Props.make("Crusher", true)
		if machine then
			Props.fit(machine, Vector3.new(18, 12, 14), Vector3.new(centerX, 6, frontZ - 7.5), true)
			Props.turn(machine, Config.PropYaw.Crusher or 0)
			machine.Name = "CrusherMachine"
			machine.Parent = folder
		end

		local toolBench = newPart(folder, "ToolBench", Vector3.new(6, 5, 6), CFrame.new(centerX - 25, 2.5, frontZ),
			Color3.fromRGB(60, 120, 200), Enum.Material.Metal)
		addLabel(toolBench, "TOOL BENCH", 8.5)
		local toolPrompt = addPrompt(toolBench, "Buy next tool", "Tool Bench")
		dress(toolBench, "ToolBench", Vector3.new(10, 8, 8), true)

		local bagStand = newPart(folder, "BackpackStand", Vector3.new(6, 5, 6), CFrame.new(centerX + 25, 2.5, frontZ),
			Color3.fromRGB(90, 170, 90), Enum.Material.Metal)
		addLabel(bagStand, "BACKPACKS", 8.5)
		local bagPrompt = addPrompt(bagStand, "Buy next backpack", "Backpack Stand")
		dress(bagStand, "BackpackStand", Vector3.new(7, 8, 7), false)

		local cratePrompt
		local crate = Config.Crates[index]
		if crate then
			local crateBox = newPart(folder, "BotCrate", Vector3.new(6, 6, 6), CFrame.new(centerX + 42, 3, frontZ),
				Color3.fromRGB(230, 120, 50), Enum.Material.DiamondPlate)
			local odds = {}
			for _, rarity in ipairs(Config.Rarities) do
				table.insert(odds, string.format("%s %s%%", rarity.name, tostring(rarity.chance)))
			end
			local label = addLabel(crateBox, string.format("BOT CRATE\n%s coins\n%s", Config.format(crate.cost),
				table.concat(odds, "  ")), 9)
			label.Parent.Size = UDim2.fromScale(24, 6)
			cratePrompt = addPrompt(crateBox, "Open crate", "Bot Crate")
			dress(crateBox, "BotCrate", Vector3.new(8, 7, 8), false)
		end

		local nextPrompt, prevPrompt
		local nextZone = Config.Zones[index + 1]
		if nextZone then
			local portal = newPart(folder, "NextPortal", Vector3.new(10, 12, 2), CFrame.new(centerX + 60, 6, frontZ),
				Color3.fromRGB(170, 90, 230), Enum.Material.Neon)
			addLabel(portal, string.format("%s\n%s coins to unlock", nextZone.name, Config.format(nextZone.cost)), 8)
			nextPrompt = addPrompt(portal, "Travel", nextZone.name)
			dress(portal, "Portal", Vector3.new(10, 12, 4), true)
		end
		local prevZone = Config.Zones[index - 1]
		if prevZone then
			local portal = newPart(folder, "PrevPortal", Vector3.new(10, 12, 2), CFrame.new(centerX - 60, 6, frontZ),
				Color3.fromRGB(120, 120, 135), Enum.Material.Neon)
			addLabel(portal, "Back to\n" .. prevZone.name, 8)
			prevPrompt = addPrompt(portal, "Travel", prevZone.name)
			dress(portal, "Portal", Vector3.new(10, 12, 4), true)
		end

		-- Scrap piles fill the area behind the stations.
		local piles = {}
		local rng = Random.new(index)
		for pileIndex = 1, Config.PilesPerZone do
			local x = centerX + rng:NextNumber(-half + 10, half - 10)
			local z = rng:NextNumber(-half + 55, half - 10)
			local pileSize = Vector3.new(rng:NextNumber(3.5, 5), rng:NextNumber(2.5, 4), rng:NextNumber(3.5, 5))
			local cframe = CFrame.new(x, pileSize.Y / 2, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
			local pile = newPart(folder, "Scrap" .. pileIndex, pileSize, cframe, zone.scrap, Enum.Material.CorrodedMetal)

			local detector = Instance.new("ClickDetector")
			detector.MaxActivationDistance = Config.TapRange
			detector.Parent = pile

			-- The box stays as the tap target; the scrap model inside it is what players see.
			local visual = Props.make("ScrapPile", false, Config.PileParts)
			if visual then
				Props.fit(visual, pileSize, cframe.Position, false)
				Props.turn(visual, rng:NextNumber(0, 360))
				for _, part in ipairs(Props.parts(visual)) do
					part.Color = zone.scrap:Lerp(part.Color, 0.35)
				end
				visual.Name = "Visual"
				visual.Parent = pile
				pile.Transparency = 1
			end

			table.insert(piles, pile)
		end

		zones[index] = {
			arrival = arrival,
			crusher = crusher,
			toolPrompt = toolPrompt,
			bagPrompt = bagPrompt,
			cratePrompt = cratePrompt,
			nextPrompt = nextPrompt,
			prevPrompt = prevPrompt,
			piles = piles,
		}
	end

	return zones
end

return World
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Bots</string><ProtectedString name="Source"><![CDATA[-- Robot rules: crate rolls, equipping and merging. Works on a player's saved data table.
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Bots = {}
local rng = Random.new()

local function roll(zoneIndex)
	local crate = Config.Crates[zoneIndex]
	local value = rng:NextNumber(0, 100)
	local total = 0
	for rarityIndex, rarity in ipairs(Config.Rarities) do
		total = total + rarity.chance
		if value < total then
			return crate.bots[rarityIndex].id
		end
	end
	return crate.bots[1].id
end

function Bots.equippedCount(data)
	local count = 0
	for _, bot in ipairs(data.bots) do
		if bot.equipped then
			count = count + 1
		end
	end
	return count
end

-- Returns the total coin bonus and collect share of the equipped bots.
function Bots.totals(data)
	local bonus = 0
	local collect = 0
	for _, bot in ipairs(data.bots) do
		if bot.equipped then
			local botBonus, botCollect = Config.botStats(bot.id, bot.polished)
			if botBonus then
				bonus = bonus + botBonus
				collect = collect + botCollect
			end
		end
	end
	return bonus, collect
end

-- Text form of the bot list, stored on the player so clients can read it.
function Bots.encode(data)
	return HttpService:JSONEncode(data.bots)
end

-- Each function below returns a message for the player, or nil.

-- free skips the cost, for developer testing.
function Bots.openCrate(data, zoneIndex, free)
	local crate = Config.Crates[zoneIndex]
	if not crate then
		return nil
	end
	if #data.bots >= Config.MaxBots then
		return string.format("You can hold %d robots. Merge some first.", Config.MaxBots)
	end
	if not free then
		if data.coins < crate.cost then
			return string.format("A crate costs %s coins. You need %s more.", Config.format(crate.cost),
				Config.format(crate.cost - data.coins))
		end
		data.coins = data.coins - crate.cost
	end

	local bot = Config.Bots[roll(zoneIndex)]
	table.insert(data.bots, {
		id = bot.id,
		polished = false,
		equipped = Bots.equippedCount(data) < Config.botSlots(data.rebirths),
	})
	data.index[bot.id] = true
	return string.format("You got a %s robot: %s!", Config.Rarities[bot.rarity].name, bot.name)
end

function Bots.setEquipped(data, id, index, equipped)
	local bot = type(index) == "number" and data.bots[index]
	if not bot or bot.id ~= id or bot.equipped == equipped then
		return nil
	end
	local slots = Config.botSlots(data.rebirths)
	if equipped and Bots.equippedCount(data) >= slots then
		return string.format("All %d robot slots are in use. Unequip one first.", slots)
	end
	bot.equipped = equipped
	return nil
end

function Bots.scrap(data, id, index)
	local bot = type(index) == "number" and data.bots[index]
	if not bot or bot.id ~= id then
		return nil
	end
	local refund = Config.botRefund(bot.id, bot.polished) or 0
	table.remove(data.bots, index)
	data.coins = data.coins + refund
	local info = Config.Bots[id]
	return string.format("Scrapped %s for %s coins", info and info.name or "robot", Config.format(refund))
end

function Bots.merge(data, id)
	local bot = type(id) == "string" and Config.Bots[id]
	if not bot then
		return nil
	end

	-- Use up unequipped copies first.
	local spare, worn = {}, {}
	for index, owned in ipairs(data.bots) do
		if owned.id == id and not owned.polished then
			table.insert(owned.equipped and worn or spare, index)
		end
	end
	local chosen = {}
	for _, index in ipairs(spare) do
		table.insert(chosen, index)
	end
	for _, index in ipairs(worn) do
		table.insert(chosen, index)
	end
	if #chosen < Config.MergeCount then
		return string.format("You need %d %s to merge.", Config.MergeCount, bot.name)
	end

	local remove = {}
	local wasEquipped = false
	for position = 1, Config.MergeCount do
		local index = chosen[position]
		wasEquipped = wasEquipped or data.bots[index].equipped
		table.insert(remove, index)
	end
	table.sort(remove, function(a, b)
		return a > b
	end)
	for _, index in ipairs(remove) do
		table.remove(data.bots, index)
	end

	table.insert(data.bots, { id = id, polished = true, equipped = wasEquipped })
	return "Merged into a Polished " .. bot.name .. "!"
end

return Bots
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX7"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Game rules. The server decides every amount; clients only tap, walk and trigger prompts.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Data = require(script.Parent:WaitForChild("Data"))
local World = require(script.Parent:WaitForChild("World"))
local Bots = require(script.Parent:WaitForChild("Bots"))

local notifyEvent = Instance.new("RemoteEvent")
notifyEvent.Name = "Notify"
notifyEvent.Parent = ReplicatedStorage

local botEvent = Instance.new("RemoteEvent")
botEvent.Name = "BotAction"
botEvent.Parent = ReplicatedStorage

local rebirthEvent = Instance.new("RemoteEvent")
rebirthEvent.Name = "Rebirth"
rebirthEvent.Parent = ReplicatedStorage

local devEvent = Instance.new("RemoteEvent")
devEvent.Name = "DevAction"
devEvent.Parent = ReplicatedStorage

-- Roblox user ids allowed to use the developer panel. The check is done here, never on the client.
local DEVELOPERS = {
	[2971849098] = true, -- juslangit
}
local DEV_MAX_COINS = 1e12 -- most coins one request can add

local zones = World.build()

local lastTap = {} -- [player] = os.clock()
local lastFullNotice = {} -- [player] = os.clock()
local lastBotAction = {} -- [player] = os.clock()

local function notify(player, message)
	notifyEvent:FireClient(player, message)
end

-- Copies the bot list onto the player. Every client reads it to draw the robots.
local function syncBots(player, data)
	local bonus = Bots.totals(data)
	player:SetAttribute("Bots", Bots.encode(data))
	player:SetAttribute("CoinBonus", bonus)
end

-- Copies saved data onto the player so the HUD and leaderboard can read it.
local function sync(player, data)
	player:SetAttribute("Coins", data.coins)
	player:SetAttribute("Scrap", data.scrap)
	player:SetAttribute("ToolIndex", data.toolIndex)
	player:SetAttribute("BackpackIndex", data.backpackIndex)
	player:SetAttribute("ZoneIndex", data.zoneIndex)
	player:SetAttribute("Rebirths", data.rebirths)

	local stats = player:FindFirstChild("leaderstats")
	local coins = stats and stats:FindFirstChild("Coins")
	if coins then
		coins.Value = data.coins
	end
	local rebirths = stats and stats:FindFirstChild("Rebirths")
	if rebirths then
		rebirths.Value = data.rebirths
	end
end

local function rootOf(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function teleport(player, zoneIndex)
	local character = player.Character
	if character then
		character:PivotTo(zones[zoneIndex].arrival)
	end
end

-- Collecting ----------------------------------------------------------------

local function setupPile(pile, zoneIndex)
	local detector = pile:FindFirstChildOfClass("ClickDetector")
	local fullSize = pile.Size
	local hits = Config.PileHits
	local active = true
	local visual = pile:FindFirstChild("Visual") -- Toolbox model, if there is one
	local fullScale = visual and visual:GetScale()

	local function respawn()
		hits = Config.PileHits
		active = true
		pile.Size = fullSize
		if visual then
			visual:ScaleTo(fullScale)
			visual.Parent = pile
		else
			pile.Transparency = 0
		end
		pile.CanCollide = true
		detector.MaxActivationDistance = Config.TapRange
	end

	detector.MouseClick:Connect(function(player)
		local data = Data.get(player)
		if not data or not active then
			return
		end

		local root = rootOf(player)
		if not root or (root.Position - pile.Position).Magnitude > Config.TapRange + 6 then
			return
		end

		local now = os.clock()
		if now - (lastTap[player] or 0) < Config.TapCooldown then
			return
		end
		lastTap[player] = now

		if zoneIndex > data.zoneIndex then
			return
		end

		local capacity = Config.Backpacks[data.backpackIndex].capacity
		local space = capacity - data.scrap
		if space <= 0 then
			if now - (lastFullNotice[player] or 0) > 2 then
				lastFullNotice[player] = now
				notify(player, "Backpack full! Sell at the crusher.")
			end
			return
		end

		local amount = math.min(Config.Tools[data.toolIndex].power, space)
		data.scrap = data.scrap + amount
		data.pending = data.pending + amount * Config.Zones[zoneIndex].mult
		data.totalScrap = data.totalScrap + amount
		sync(player, data)

		hits = hits - 1
		if hits <= 0 then
			active = false
			pile.Transparency = 1
			pile.CanCollide = false
			if visual then
				visual.Parent = nil
			end
			detector.MaxActivationDistance = 0
			task.delay(Config.PileRespawn, respawn)
		else
			local shrink = 0.6 + 0.4 * hits / Config.PileHits
			pile.Size = fullSize * shrink
			if visual then
				visual:ScaleTo(fullScale * shrink)
			end
		end
	end)
end

-- Selling -------------------------------------------------------------------

local function setupCrusher(crusher)
	crusher.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		local data = player and Data.get(player)
		if not data or data.scrap <= 0 then
			return
		end
		local bonus = Bots.totals(data)
		local earned = math.floor(data.pending * (1 + bonus) * (1 + Config.RebirthBonus * data.rebirths))
		data.coins = data.coins + earned
		data.scrap = 0
		data.pending = 0
		sync(player, data)
		notify(player, "Sold for " .. Config.format(earned) .. " coins")
	end)
end

-- Upgrades ------------------------------------------------------------------

local function buyNext(player, list, indexKey)
	local data = Data.get(player)
	if not data then
		return
	end
	local nextItem = list[data[indexKey] + 1]
	if not nextItem then
		notify(player, "You already own the best one.")
		return
	end
	if data.coins < nextItem.cost then
		notify(player, string.format("%s costs %s coins. You need %s more.", nextItem.name,
			Config.format(nextItem.cost), Config.format(nextItem.cost - data.coins)))
		return
	end
	data.coins = data.coins - nextItem.cost
	data[indexKey] = data[indexKey] + 1
	sync(player, data)
	notify(player, "Bought " .. nextItem.name .. "!")
end

-- Zones ---------------------------------------------------------------------

local function travelForward(player, targetIndex)
	local data = Data.get(player)
	if not data then
		return
	end
	local target = Config.Zones[targetIndex]
	if data.zoneIndex < targetIndex then
		if data.zoneIndex < targetIndex - 1 then
			return
		end
		if data.coins < target.cost then
			notify(player, string.format("%s costs %s coins. You need %s more.", target.name,
				Config.format(target.cost), Config.format(target.cost - data.coins)))
			return
		end
		data.coins = data.coins - target.cost
		data.zoneIndex = targetIndex
		sync(player, data)
		notify(player, "Unlocked " .. target.name .. "!")
	end
	teleport(player, targetIndex)
end

-- Rebirth -------------------------------------------------------------------

rebirthEvent.OnServerEvent:Connect(function(player)
	local data = Data.get(player)
	if not data then
		return
	end
	local cost = Config.rebirthCost(data.rebirths)
	if data.coins < cost then
		notify(player, string.format("Rebirth costs %s coins. You need %s more.", Config.format(cost),
			Config.format(cost - data.coins)))
		return
	end

	data.rebirths = data.rebirths + 1
	data.coins = 0
	data.scrap = 0
	data.pending = 0
	data.toolIndex = 1
	data.backpackIndex = 1
	data.zoneIndex = 1
	sync(player, data)
	syncBots(player, data)
	teleport(player, 1)
	notify(player, string.format("Rebirth %d! You now earn +%d%% coins.", data.rebirths,
		math.floor(Config.RebirthBonus * data.rebirths * 100 + 0.5)))
end)

-- Robots --------------------------------------------------------------------

local function openCrate(player, zoneIndex)
	local data = Data.get(player)
	if not data or zoneIndex > data.zoneIndex then
		return
	end
	local message = Bots.openCrate(data, zoneIndex)
	sync(player, data)
	syncBots(player, data)
	if message then
		notify(player, message)
	end
end

botEvent.OnServerEvent:Connect(function(player, action, id, index)
	local data = Data.get(player)
	if not data then
		return
	end

	local now = os.clock()
	if now - (lastBotAction[player] or 0) < Config.BotActionCooldown then
		return
	end
	lastBotAction[player] = now

	local message
	if action == "equip" or action == "unequip" then
		message = Bots.setEquipped(data, id, index, action == "equip")
	elseif action == "merge" then
		message = Bots.merge(data, id)
	elseif action == "scrap" then
		message = Bots.scrap(data, id, index)
	else
		return
	end
	sync(player, data)
	syncBots(player, data)
	if message then
		notify(player, message)
	end
end)

local function zoneAt(position)
	local index = math.floor(position.X / (Config.ZoneSize + Config.ZoneGap) + 0.5) + 1
	return math.clamp(index, 1, #Config.Zones)
end

-- Equipped robots collect for their owner, valued at the zone the owner is standing in.
task.spawn(function()
	while true do
		task.wait(Config.BotTick)
		for _, player in ipairs(Players:GetPlayers()) do
			local data = Data.get(player)
			local root = rootOf(player)
			if data and root then
				local _, collect = Bots.totals(data)
				local space = Config.Backpacks[data.backpackIndex].capacity - data.scrap
				if collect > 0 and space > 0 then
					local zoneIndex = math.min(zoneAt(root.Position), data.zoneIndex)
					local amount = math.min(math.ceil(Config.Tools[data.toolIndex].power * collect), space)
					data.scrap = data.scrap + amount
					data.pending = data.pending + amount * Config.Zones[zoneIndex].mult
					data.totalScrap = data.totalScrap + amount
					sync(player, data)
				end
			end
		end
	end
end)

for index, zone in ipairs(zones) do
	for _, pile in ipairs(zone.piles) do
		setupPile(pile, index)
	end
	setupCrusher(zone.crusher)

	zone.toolPrompt.Triggered:Connect(function(player)
		buyNext(player, Config.Tools, "toolIndex")
	end)
	zone.bagPrompt.Triggered:Connect(function(player)
		buyNext(player, Config.Backpacks, "backpackIndex")
	end)
	if zone.cratePrompt then
		zone.cratePrompt.Triggered:Connect(function(player)
			openCrate(player, index)
		end)
	end
	if zone.nextPrompt then
		zone.nextPrompt.Triggered:Connect(function(player)
			travelForward(player, index + 1)
		end)
	end
	if zone.prevPrompt then
		zone.prevPrompt.Triggered:Connect(function(player)
			if Data.get(player) then
				teleport(player, index - 1)
			end
		end)
	end
end

-- Developer panel -----------------------------------------------------------

devEvent.OnServerEvent:Connect(function(player, action, value)
	if not DEVELOPERS[player.UserId] then
		return
	end
	local data = Data.get(player)
	if not data then
		return
	end

	local message
	if action == "coins" then
		if type(value) ~= "number" or value ~= value or value <= 0 then
			return
		end
		local amount = math.floor(math.min(value, DEV_MAX_COINS))
		data.coins = data.coins + amount
		message = "Dev: added " .. Config.format(amount) .. " coins"
	elseif action == "robot" then
		if type(value) ~= "number" or not Config.Crates[value] then
			return
		end
		message = Bots.openCrate(data, value, true)
	elseif action == "gear" then
		data.toolIndex = #Config.Tools
		data.backpackIndex = #Config.Backpacks
		message = "Dev: best tool and backpack"
	elseif action == "zones" then
		data.zoneIndex = #Config.Zones
		message = "Dev: all zones unlocked"
	elseif action == "rebirth" then
		data.rebirths = data.rebirths + 1
		message = "Dev: rebirths set to " .. data.rebirths
	elseif action == "reset" then
		data = Data.reset(player)
		teleport(player, 1)
		message = "Dev: save wiped"
	else
		return
	end

	sync(player, data)
	syncBots(player, data)
	if message then
		notify(player, message)
	end
end)

-- Players -------------------------------------------------------------------

local function onPlayerAdded(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player

	if DEVELOPERS[player.UserId] then
		player:SetAttribute("Developer", true)
	end

	local data = Data.load(player)
	if data then
		sync(player, data)
		syncBots(player, data)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	Data.release(player)
	lastTap[player] = nil
	lastFullNotice[player] = nil
	lastBotAction[player] = nil
end)
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX15"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX14"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX9"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- On-screen display. Reads values the server puts on the player; never changes them.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local notifyEvent = ReplicatedStorage:WaitForChild("Notify")

local player = Players.LocalPlayer

local INK = Color3.fromRGB(22, 36, 43)
local WHITE = Color3.fromRGB(255, 255, 255)
local HAZARD = Color3.fromRGB(242, 183, 5)

local gui = Instance.new("ScreenGui")
gui.Name = "Hud"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function newLabel(parent, size, position, textSize, bold)
	local label = Instance.new("TextLabel")
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium
	label.TextSize = textSize
	label.TextColor3 = WHITE
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = ""
	label.Parent = parent
	return label
end

-- Stats panel, left side
local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(250, 204)
panel.Position = UDim2.new(0, 12, 0.5, -102)
panel.BackgroundColor3 = INK
panel.BackgroundTransparency = 0.15
panel.BorderSizePixel = 0
panel.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = panel

local coinsLabel = newLabel(panel, UDim2.new(1, -24, 0, 30), UDim2.fromOffset(12, 8), 24, true)
coinsLabel.TextColor3 = HAZARD
local bagLabel = newLabel(panel, UDim2.new(1, -24, 0, 20), UDim2.fromOffset(12, 42), 16, true)

local barBack = Instance.new("Frame")
barBack.Size = UDim2.new(1, -24, 0, 10)
barBack.Position = UDim2.fromOffset(12, 66)
barBack.BackgroundColor3 = Color3.fromRGB(60, 78, 86)
barBack.BorderSizePixel = 0
barBack.Parent = panel

local barFill = Instance.new("Frame")
barFill.Size = UDim2.fromScale(0, 1)
barFill.BackgroundColor3 = HAZARD
barFill.BorderSizePixel = 0
barFill.Parent = barBack

local toolLabel = newLabel(panel, UDim2.new(1, -24, 0, 18), UDim2.fromOffset(12, 88), 14, false)
local nextToolLabel = newLabel(panel, UDim2.new(1, -24, 0, 18), UDim2.fromOffset(12, 106), 14, false)
local nextBagLabel = newLabel(panel, UDim2.new(1, -24, 0, 18), UDim2.fromOffset(12, 124), 14, false)
local nextZoneLabel = newLabel(panel, UDim2.new(1, -24, 0, 18), UDim2.fromOffset(12, 142), 14, false)
local bonusLabel = newLabel(panel, UDim2.new(1, -24, 0, 18), UDim2.fromOffset(12, 160), 14, false)
local rebirthLabel = newLabel(panel, UDim2.new(1, -24, 0, 18), UDim2.fromOffset(12, 178), 14, false)

-- Message banner, top centre
local toast = Instance.new("TextLabel")
toast.Size = UDim2.fromOffset(420, 40)
toast.Position = UDim2.new(0.5, -210, 0, 70)
toast.BackgroundColor3 = INK
toast.BackgroundTransparency = 0.1
toast.BorderSizePixel = 0
toast.Font = Enum.Font.GothamBold
toast.TextSize = 18
toast.TextColor3 = WHITE
toast.TextWrapped = true
toast.Visible = false
toast.Parent = gui

local toastCorner = Instance.new("UICorner")
toastCorner.CornerRadius = UDim.new(0, 8)
toastCorner.Parent = toast

local toastToken = 0
notifyEvent.OnClientEvent:Connect(function(message)
	toastToken = toastToken + 1
	local token = toastToken
	toast.Text = message
	toast.Visible = true
	task.delay(2.5, function()
		if token == toastToken then
			toast.Visible = false
		end
	end)
end)

-- "+3" pop-up each time scrap is collected
local function popup(amount)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromOffset(120, 36)
	label.Position = UDim2.new(0.5, math.random(-90, 30), 0.5, math.random(-70, -30))
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 28
	label.TextColor3 = HAZARD
	label.TextStrokeTransparency = 0
	label.Text = "+" .. Config.format(amount)
	label.Parent = gui

	local tween = TweenService:Create(label, TweenInfo.new(0.6), {
		Position = label.Position - UDim2.fromOffset(0, 60),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	tween.Completed:Connect(function()
		label:Destroy()
	end)
	tween:Play()
end

local function describeNext(prefix, item)
	if item then
		return string.format("%s: %s (%s)", prefix, item.name, Config.format(item.cost))
	end
	return prefix .. ": max"
end

-- Signs above the tool bench and backpack stand. The server builds them; the text is set here
-- because the next price is different for each player.
local map = Workspace:WaitForChild("Map")

local function priceLine(item)
	if item then
		return string.format("%s: %s coins", item.name, Config.format(item.cost))
	end
	return "You own the best one"
end

local function setSign(zoneFolder, partName, text)
	local part = zoneFolder:FindFirstChild(partName)
	local sign = part and part:FindFirstChild("Label")
	local label = sign and sign:FindFirstChildOfClass("TextLabel")
	if label then
		label.Text = text
	end
end

local function refreshSigns()
	local toolText = "TOOL BENCH\n" .. priceLine(Config.Tools[(player:GetAttribute("ToolIndex") or 1) + 1])
	local bagText = "BACKPACKS\n" .. priceLine(Config.Backpacks[(player:GetAttribute("BackpackIndex") or 1) + 1])
	for _, zoneFolder in ipairs(map:GetChildren()) do
		setSign(zoneFolder, "ToolBench", toolText)
		setSign(zoneFolder, "BackpackStand", bagText)
	end
end

-- Signs in far zones can load late.
map.DescendantAdded:Connect(function(descendant)
	if descendant:IsA("TextLabel") then
		task.defer(refreshSigns)
	end
end)

local lastScrap = nil

local function refresh()
	local coins = player:GetAttribute("Coins") or 0
	local scrap = player:GetAttribute("Scrap") or 0
	local toolIndex = player:GetAttribute("ToolIndex") or 1
	local backpackIndex = player:GetAttribute("BackpackIndex") or 1
	local zoneIndex = player:GetAttribute("ZoneIndex") or 1

	local tool = Config.Tools[toolIndex]
	local backpack = Config.Backpacks[backpackIndex]

	coinsLabel.Text = Config.format(coins) .. " coins"
	bagLabel.Text = string.format("Backpack %s / %s", Config.format(scrap), Config.format(backpack.capacity))
	barFill.Size = UDim2.fromScale(math.clamp(scrap / backpack.capacity, 0, 1), 1)
	toolLabel.Text = string.format("Tool: %s (+%d per tap)", tool.name, tool.power)
	nextToolLabel.Text = describeNext("Next tool", Config.Tools[toolIndex + 1])
	nextBagLabel.Text = describeNext("Next backpack", Config.Backpacks[backpackIndex + 1])
	nextZoneLabel.Text = describeNext("Next zone", Config.Zones[zoneIndex + 1])
	bonusLabel.Text = string.format("Robots: +%d%% coins", math.floor((player:GetAttribute("CoinBonus") or 0) * 100 + 0.5))

	local rebirths = player:GetAttribute("Rebirths") or 0
	rebirthLabel.Text = string.format("Rebirths: %d (+%d%% coins)", rebirths,
		math.floor(Config.RebirthBonus * rebirths * 100 + 0.5))

	refreshSigns()

	if lastScrap ~= nil and scrap > lastScrap then
		popup(scrap - lastScrap)
	end
	lastScrap = scrap
end

player.AttributeChanged:Connect(refresh)
refresh()
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX10"><Properties><string name="Name">Inventory</string><ProtectedString name="Source"><![CDATA[-- Robot inventory. Shows the bots the server says the player owns and asks it to equip or merge.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local botEvent = ReplicatedStorage:WaitForChild("BotAction")

local player = Players.LocalPlayer

local INK = Color3.fromRGB(22, 36, 43)
local ROW = Color3.fromRGB(40, 58, 66)
local WHITE = Color3.fromRGB(255, 255, 255)
local HAZARD = Color3.fromRGB(242, 183, 5)
local TEAL = Color3.fromRGB(18, 105, 107)
local GREY = Color3.fromRGB(90, 104, 110)
local RED = Color3.fromRGB(190, 60, 55)

local gui = Instance.new("ScreenGui")
gui.Name = "Inventory"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function round(instance)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = instance
end

local function newButton(parent, size, position, text, color)
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = color
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Font = Enum.Font.GothamBold
	button.TextSize = 16
	button.TextColor3 = WHITE
	button.Text = text
	button.Parent = parent
	round(button)
	return button
end

local function newLabel(parent, size, position, textSize, color)
	local label = Instance.new("TextLabel")
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = textSize
	label.TextColor3 = color
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Text = ""
	label.Parent = parent
	return label
end

-- Open button, under the stats panel
local openButton = newButton(gui, UDim2.fromOffset(121, 44), UDim2.new(0, 12, 0.5, 110), "Robots", TEAL)

-- Window, centre of the screen
local window = Instance.new("Frame")
window.AnchorPoint = Vector2.new(0.5, 0.5)
window.Size = UDim2.new(0, 380, 0.85, 0)
window.Position = UDim2.fromScale(0.5, 0.5)
window.BackgroundColor3 = INK
window.BackgroundTransparency = 0.05
window.BorderSizePixel = 0
window.Visible = false
window.Parent = gui
round(window)

local limit = Instance.new("UISizeConstraint")
limit.MaxSize = Vector2.new(380, 440)
limit.Parent = window

local title = newLabel(window, UDim2.new(1, -72, 0, 24), UDim2.fromOffset(14, 10), 20, HAZARD)
local summary = newLabel(window, UDim2.new(1, -72, 0, 18), UDim2.fromOffset(14, 36), 14, WHITE)
local closeButton = newButton(window, UDim2.fromOffset(44, 44), UDim2.new(1, -52, 0, 8), "X", GREY)

local list = Instance.new("ScrollingFrame")
list.Size = UDim2.new(1, -20, 1, -74)
list.Position = UDim2.fromOffset(10, 64)
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.ScrollBarThickness = 6
list.CanvasSize = UDim2.new()
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.Parent = window

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = list

local function readBots()
	local ok, bots = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute("Bots") or "[]")
	end)
	return ok and type(bots) == "table" and bots or {}
end

local function percent(value)
	return math.floor(value * 100 + 0.5)
end

local function refresh()
	for _, child in ipairs(list:GetChildren()) do
		if child ~= layout then
			child:Destroy()
		end
	end

	local bots = readBots()
	local equipped = 0
	local spare = {} -- [id] = number of unpolished copies
	for _, bot in ipairs(bots) do
		if bot.equipped then
			equipped = equipped + 1
		end
		if not bot.polished then
			spare[bot.id] = (spare[bot.id] or 0) + 1
		end
	end

	title.Text = string.format("Robots %d / %d", #bots, Config.MaxBots)
	summary.Text = string.format("%d of %d equipped, +%d%% coins", equipped,
		Config.botSlots(player:GetAttribute("Rebirths") or 0),
		percent(player:GetAttribute("CoinBonus") or 0))
	openButton.Text = string.format("Robots (%d)", #bots)

	local order = 0

	-- Merge buttons first, so they are easy to find.
	for id, count in pairs(spare) do
		local bot = Config.Bots[id]
		if bot and count >= Config.MergeCount then
			order = order + 1
			local merge = newButton(list, UDim2.new(1, -8, 0, 44), UDim2.new(),
				string.format("Merge %d x %s into Polished", Config.MergeCount, bot.name), HAZARD)
			merge.TextColor3 = INK
			merge.LayoutOrder = order
			merge.Activated:Connect(function()
				botEvent:FireServer("merge", id)
			end)
		end
	end

	if #bots == 0 then
		local empty = newLabel(list, UDim2.new(1, -8, 0, 44), UDim2.new(), 15, WHITE)
		empty.TextWrapped = true
		empty.Text = "No robots yet. Open a Bot Crate next to the crusher."
		return
	end

	for index, bot in ipairs(bots) do
		local info = Config.Bots[bot.id]
		local bonus = Config.botStats(bot.id, bot.polished)
		if info and bonus then
			local rarity = Config.Rarities[info.rarity]
			order = order + 1

			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -8, 0, 52)
			row.BackgroundColor3 = ROW
			row.BorderSizePixel = 0
			row.LayoutOrder = order
			row.Parent = list
			round(row)

			local name = newLabel(row, UDim2.new(1, -196, 0, 22), UDim2.fromOffset(10, 6), 16, rarity.color)
			name.Text = (bot.polished and "Polished " or "") .. info.name
			local detail = newLabel(row, UDim2.new(1, -196, 0, 18), UDim2.fromOffset(10, 28), 13, WHITE)
			detail.Text = string.format("%s, +%d%% coins", rarity.name, percent(bonus))

			local toggle = newButton(row, UDim2.fromOffset(84, 40), UDim2.new(1, -180, 0, 6),
				bot.equipped and "Unequip" or "Equip", bot.equipped and GREY or TEAL)
			toggle.TextSize = 14
			toggle.Activated:Connect(function()
				botEvent:FireServer(bot.equipped and "unequip" or "equip", bot.id, index)
			end)

			-- Scrapping needs a second tap, so a robot is never lost by accident.
			local scrapText = "Scrap +" .. Config.format(Config.botRefund(bot.id, bot.polished))
			local scrap = newButton(row, UDim2.fromOffset(84, 40), UDim2.new(1, -90, 0, 6), scrapText, RED)
			scrap.TextSize = 14
			local armed = false
			scrap.Activated:Connect(function()
				if armed then
					botEvent:FireServer("scrap", bot.id, index)
					return
				end
				armed = true
				scrap.Text = "Sure?"
				task.delay(2.5, function()
					armed = false
					if scrap.Parent then
						scrap.Text = scrapText
					end
				end)
			end)
		end
	end
end

openButton.Activated:Connect(function()
	window.Visible = not window.Visible
end)
closeButton.Activated:Connect(function()
	window.Visible = false
end)

player:GetAttributeChangedSignal("Bots"):Connect(refresh)
player:GetAttributeChangedSignal("CoinBonus"):Connect(refresh)
player:GetAttributeChangedSignal("Rebirths"):Connect(refresh)
refresh()
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX11"><Properties><string name="Name">BotFollow</string><ProtectedString name="Source"><![CDATA[-- Draws every player's equipped robots following them. Visual only; the server tracks bots as numbers.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Props = require(ReplicatedStorage:WaitForChild("Props"))

local ROOT_HEIGHT = 3 -- studs from a character's root part down to the ground

-- The robot model must have fully arrived before the first copy is made.
if not game:IsLoaded() then
	game.Loaded:Wait()
end

local folder = Instance.new("Folder")
folder.Name = "BotVisuals"
folder.Parent = Workspace

local visuals = {} -- [player] = list of models

local function clear(target)
	for _, model in ipairs(visuals[target] or {}) do
		model:Destroy()
	end
	visuals[target] = nil
end

-- Builds one robot standing on the origin with its pivot at its feet.
local function newBot(bot, info)
	local rarity = Config.Rarities[info.rarity]
	local height = 2.4 + 0.35 * info.rarity

	local model = Props.make("Robot", false)
	if model then
		Props.fit(model, Vector3.new(height, height, height), Vector3.new(0, height / 2, 0), false)
		Props.turn(model, Config.PropYaw.Robot or 0)
		for _, part in ipairs(Props.parts(model)) do
			if not part:FindFirstAncestorWhichIsA("Accessory") then
				part.Color = rarity.color
				if bot.polished then
					part.Material = Enum.Material.Neon
				end
			end
		end
	else
		-- No robot model in this build: fall back to a plain block.
		model = Instance.new("Model")
		local block = Instance.new("Part")
		block.Anchored = true
		block.CanCollide = false
		block.CanQuery = false
		block.CanTouch = false
		block.Size = Vector3.new(height, height, height) * 0.7
		block.Position = Vector3.new(0, block.Size.Y / 2, 0)
		block.Color = rarity.color
		block.Material = bot.polished and Enum.Material.Neon or Enum.Material.Metal
		block.Parent = model
		model.WorldPivot = CFrame.new()
	end
	model.Name = info.id

	-- Invisible part at the feet that carries the name tag.
	local anchor = Instance.new("Part")
	anchor.Name = "Tag"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = model:GetPivot()
	anchor.Parent = model

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(7, 1) -- in studs, so the name keeps its size in the world at any distance
	gui.StudsOffset = Vector3.new(0, height + 1, 0)
	gui.MaxDistance = 45
	gui.Parent = anchor

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = rarity.color
	label.TextStrokeTransparency = 0
	label.Text = (bot.polished and "Polished " or "") .. info.name
	label.Parent = gui

	return model
end

local function rebuild(target)
	clear(target)

	local ok, bots = pcall(function()
		return HttpService:JSONDecode(target:GetAttribute("Bots") or "[]")
	end)
	if not ok or type(bots) ~= "table" then
		return
	end

	local models = {}
	for _, bot in ipairs(bots) do
		local info = Config.Bots[bot.id]
		if bot.equipped and info then
			table.insert(models, newBot(bot, info))
		end
	end
	visuals[target] = models
end

local function watch(target)
	target:GetAttributeChangedSignal("Bots"):Connect(function()
		rebuild(target)
	end)
	rebuild(target)
end

Players.PlayerAdded:Connect(watch)
Players.PlayerRemoving:Connect(clear)
for _, target in ipairs(Players:GetPlayers()) do
	task.spawn(watch, target)
end

RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	for target, models in pairs(visuals) do
		local character = target.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		for slot, model in ipairs(models) do
			if root then
				-- A row behind the owner, bobbing a little.
				local x = (slot - (#models + 1) / 2) * 4
				local y = -ROOT_HEIGHT + 0.3 + math.sin(now * 3 + slot) * 0.3
				local goal = root.CFrame * CFrame.new(x, y, 5)
				if model.Parent ~= folder then
					model:PivotTo(goal)
					model.Parent = folder
				else
					model:PivotTo(model:GetPivot():Lerp(goal, math.min(1, dt * 8)))
				end
			else
				model.Parent = nil
			end
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX12"><Properties><string name="Name">Rebirth</string><ProtectedString name="Source"><![CDATA[-- Rebirth window. Explains the trade and asks the server to do it; the server checks the cost.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local rebirthEvent = ReplicatedStorage:WaitForChild("Rebirth")

local player = Players.LocalPlayer

local INK = Color3.fromRGB(22, 36, 43)
local WHITE = Color3.fromRGB(255, 255, 255)
local HAZARD = Color3.fromRGB(242, 183, 5)
local PURPLE = Color3.fromRGB(140, 80, 210)
local GREY = Color3.fromRGB(90, 104, 110)

local gui = Instance.new("ScreenGui")
gui.Name = "Rebirth"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function round(instance)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = instance
end

local function newButton(parent, size, position, text, color)
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = color
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamBold
	button.TextSize = 16
	button.TextColor3 = WHITE
	button.Text = text
	button.Parent = parent
	round(button)
	return button
end

-- Open button, beside the Robots button
local openButton = newButton(gui, UDim2.fromOffset(121, 44), UDim2.new(0, 141, 0.5, 110), "Rebirth", PURPLE)

-- Window, centre of the screen
local window = Instance.new("Frame")
window.AnchorPoint = Vector2.new(0.5, 0.5)
window.Size = UDim2.fromOffset(360, 290)
window.Position = UDim2.fromScale(0.5, 0.5)
window.BackgroundColor3 = INK
window.BackgroundTransparency = 0.05
window.BorderSizePixel = 0
window.Visible = false
window.Parent = gui
round(window)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -72, 0, 24)
title.Position = UDim2.fromOffset(14, 12)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.TextSize = 20
title.TextColor3 = HAZARD
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = window

local body = Instance.new("TextLabel")
body.Size = UDim2.new(1, -28, 0, 170)
body.Position = UDim2.fromOffset(14, 50)
body.BackgroundTransparency = 1
body.Font = Enum.Font.GothamMedium
body.TextSize = 15
body.TextColor3 = WHITE
body.TextWrapped = true
body.TextXAlignment = Enum.TextXAlignment.Left
body.TextYAlignment = Enum.TextYAlignment.Top
body.Parent = window

local closeButton = newButton(window, UDim2.fromOffset(44, 44), UDim2.new(1, -52, 0, 8), "X", GREY)
local confirmButton = newButton(window, UDim2.new(1, -28, 0, 48), UDim2.new(0, 14, 1, -60), "", PURPLE)

local function percent(rebirths)
	return math.floor(Config.RebirthBonus * rebirths * 100 + 0.5)
end

local function refresh()
	local rebirths = player:GetAttribute("Rebirths") or 0
	local coins = player:GetAttribute("Coins") or 0
	local cost = Config.rebirthCost(rebirths)

	local slotLine = ""
	if Config.botSlots(rebirths + 1) > Config.botSlots(rebirths) then
		slotLine = "\nYou also get 1 more robot slot."
	end

	title.Text = "Rebirth " .. (rebirths + 1)
	body.Text = string.format(
		"Cost: %s coins\n\nYou lose: coins, tools, backpacks and unlocked zones.\nYou keep: all your robots.\n\n"
			.. "Coin bonus goes from +%d%% to +%d%%, forever.%s",
		Config.format(cost), percent(rebirths), percent(rebirths + 1), slotLine)

	if coins >= cost then
		confirmButton.Text = "Rebirth now"
		confirmButton.BackgroundColor3 = PURPLE
	else
		confirmButton.Text = string.format("Need %s more coins", Config.format(cost - coins))
		confirmButton.BackgroundColor3 = GREY
	end
end

openButton.Activated:Connect(function()
	window.Visible = not window.Visible
end)
closeButton.Activated:Connect(function()
	window.Visible = false
end)
confirmButton.Activated:Connect(function()
	if (player:GetAttribute("Coins") or 0) >= Config.rebirthCost(player:GetAttribute("Rebirths") or 0) then
		rebirthEvent:FireServer()
		window.Visible = false
	end
end)

player:GetAttributeChangedSignal("Coins"):Connect(refresh)
player:GetAttributeChangedSignal("Rebirths"):Connect(refresh)
refresh()
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX13"><Properties><string name="Name">Dev</string><ProtectedString name="Source"><![CDATA[-- Developer panel. Only shown to players the server marks as developers; the server checks again on every request.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local devEvent = ReplicatedStorage:WaitForChild("DevAction")

local player = Players.LocalPlayer

local INK = Color3.fromRGB(22, 36, 43)
local WHITE = Color3.fromRGB(255, 255, 255)
local HAZARD = Color3.fromRGB(242, 183, 5)
local ORANGE = Color3.fromRGB(215, 110, 40)
local ROW = Color3.fromRGB(40, 58, 66)
local RED = Color3.fromRGB(190, 60, 55)
local GREY = Color3.fromRGB(90, 104, 110)

local function round(instance)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = instance
end

local function newButton(parent, size, position, text, color)
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = color
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamBold
	button.TextSize = 15
	button.TextColor3 = WHITE
	button.Text = text
	button.Parent = parent
	round(button)
	return button
end

local function build()
	local gui = Instance.new("ScreenGui")
	gui.Name = "Dev"
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")

	-- Open button, right edge of the screen
	local openButton = newButton(gui, UDim2.fromOffset(70, 44), UDim2.new(1, -82, 0.5, -22), "DEV", ORANGE)

	local window = Instance.new("Frame")
	window.AnchorPoint = Vector2.new(1, 0.5)
	window.Size = UDim2.new(0, 250, 0.85, 0)
	window.Position = UDim2.new(1, -92, 0.5, 0)
	window.BackgroundColor3 = INK
	window.BackgroundTransparency = 0.05
	window.BorderSizePixel = 0
	window.Visible = false
	window.Parent = gui
	round(window)

	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(250, 560)
	limit.Parent = window

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -28, 0, 24)
	title.Position = UDim2.fromOffset(14, 10)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextSize = 18
	title.TextColor3 = HAZARD
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "Developer"
	title.Parent = window

	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, -20, 1, -52)
	list.Position = UDim2.fromOffset(10, 42)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = window

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	local order = 0
	local function action(text, color, name, value)
		order = order + 1
		local button = newButton(list, UDim2.new(1, -8, 0, 40), UDim2.new(), text, color)
		button.LayoutOrder = order
		button.Activated:Connect(function()
			devEvent:FireServer(name, value)
		end)
		return button
	end

	for _, amount in ipairs({ 1000, 100000, 10000000, 1000000000 }) do
		action("+" .. Config.format(amount) .. " coins", ROW, "coins", amount)
	end
	for zoneIndex, zone in ipairs(Config.Zones) do
		if Config.Crates[zoneIndex] then
			action("Free robot: " .. zone.name, ROW, "robot", zoneIndex)
		end
	end
	action("Best tool and backpack", ROW, "gear")
	action("Unlock all zones", ROW, "zones")
	action("+1 rebirth", ROW, "rebirth")

	-- Wiping the save needs a second tap.
	order = order + 1
	local reset = newButton(list, UDim2.new(1, -8, 0, 40), UDim2.new(), "Wipe my save", RED)
	reset.LayoutOrder = order
	local armed = false
	reset.Activated:Connect(function()
		if armed then
			armed = false
			reset.Text = "Wipe my save"
			devEvent:FireServer("reset")
			return
		end
		armed = true
		reset.Text = "Sure? Tap again"
		task.delay(2.5, function()
			if armed then
				armed = false
				reset.Text = "Wipe my save"
			end
		end)
	end)

	openButton.Activated:Connect(function()
		window.Visible = not window.Visible
		openButton.BackgroundColor3 = window.Visible and GREY or ORANGE
	end)
end

if player:GetAttribute("Developer") then
	build()
else
	local connection
	connection = player:GetAttributeChangedSignal("Developer"):Connect(function()
		if player:GetAttribute("Developer") then
			connection:Disconnect()
			build()
		end
	end)
end
]]></ProtectedString></Properties></Item></Item></Item><SharedStrings>
